EXPORTS += [
    'nsWindow.h',
]

EXPORTS.mozilla.widget += [
    'HaikuRemote.h',
]

# The Be API headers don't mix with unified builds, so build each file alone.
SOURCES += [
    'GfxInfo.cpp',
    'HaikuApplication.cpp',
    'HaikuCursor.cpp',
    'HaikuFilePanel.cpp',
    'HaikuKeyboard.cpp',
    'HaikuUtils.cpp',
    'HaikuView.cpp',
    'HaikuWindowBuffer.cpp',
    'nsAppShell.cpp',
    'nsBidiKeyboard.cpp',
    'nsClipboard.cpp',
    'nsDragService.cpp',
    'nsFilePicker.cpp',
    'nsIdleServiceHaiku.cpp',
    'nsLookAndFeel.cpp',
    'nsNativeThemeHaiku.cpp',
    'nsScreenHaiku.cpp',
    'nsSound.cpp',
    'nsWidgetFactory.cpp',
    'nsWindow.cpp',
]

if CONFIG['NS_PRINTING']:
    SOURCES += [
        'HaikuPrintView.cpp',
        'nsDeviceContextSpecHaiku.cpp',
    ]
    SOURCES['HaikuPrintView.cpp'].flags += ['-frtti']

include('/ipc/chromium/chromium-config.mozbuild')

FINAL_LIBRARY = 'xul'

# libbe dynamic_casts BHandler/BView objects, so files defining classes derived
# from Be classes need RTTI. They must not define Gecko polymorphic classes,
# whose typeinfo doesn't exist (Gecko is built without RTTI).
for f in ('HaikuApplication.cpp', 'HaikuFilePanel.cpp', 'HaikuView.cpp'):
    SOURCES[f].flags += ['-frtti']

# BFilePanel lives in libtracker, not libbe.
OS_LIBS += ['tracker']

LOCAL_INCLUDES += [
    '/gfx/layers/client',
    '/layout/base',
    '/layout/generic',
    '/layout/xul',
    '/widget',
]

CXXFLAGS += CONFIG['MOZ_CAIRO_CFLAGS']
