EXPORTS += [
    'nsWindow.h',
]

EXPORTS.mozilla.widget += [
    'HaikuRemote.h',
]

# The Be API headers don't mix with unified builds, so build each file alone.
# No -frtti: the rest of Gecko is built without RTTI, so classes derived from
# Gecko classes would need typeinfo that doesn't exist.
SOURCES += [
    'GfxInfo.cpp',
    'HaikuApplication.cpp',
    'HaikuCursor.cpp',
    'HaikuKeyboard.cpp',
    'HaikuUtils.cpp',
    'HaikuView.cpp',
    'HaikuWindowBuffer.cpp',
    'nsAppShell.cpp',
    'nsBidiKeyboard.cpp',
    'nsClipboard.cpp',
    'nsDragService.cpp',
    'nsFilePicker.cpp',
    'nsIdleServiceHaiku.cpp',
    'nsLookAndFeel.cpp',
    'nsNativeThemeHaiku.cpp',
    'nsScreenHaiku.cpp',
    'nsSound.cpp',
    'nsWidgetFactory.cpp',
    'nsWindow.cpp',
]

if CONFIG['NS_PRINTING']:
    SOURCES += [
        'nsDeviceContextSpecHaiku.cpp',
    ]

include('/ipc/chromium/chromium-config.mozbuild')

FINAL_LIBRARY = 'xul'

LOCAL_INCLUDES += [
    '/gfx/layers/client',
    '/layout/base',
    '/layout/generic',
    '/layout/xul',
    '/widget',
]

CXXFLAGS += CONFIG['MOZ_CAIRO_CFLAGS']
